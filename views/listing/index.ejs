<% layout("/layouts/boilerplate") %>
<body> 
    <div class="filters card-body">
    <div class="icons"><i class="bi bi-house-door-fill "></i><p class="text">villa</p></div>
    <div class="icons"><i class="bi bi-snow "></i><p class="text">Winters</p></div>
    <div class="icons"><i class="bi bi-fire "></i><p class="text">Summers</p></div>
    <div class="icons"><i class="bi bi-stars "></i><p class="text">Hot</p></div>
    <div class="icons"><i class="bi bi-buildings"></i><p class="text">Appartments</p></div>
    <div class="icons"><i class="bi bi-cake-fill"></i><p class="text">Birthday</p></div>
    <div class="icons"><i class="bi bi-calendar-heart"></i><p class="text">Honeymoon</p></div>
    <div class="icons"><i class="bi bi-airplane-fill"></i><p class="text">International</p></div>
    <div class="icons"><i class="bi bi-train-front-fill "></i><p class="text">Train</p></div>
    <div class="form-check form-switch form-check-reverse taxswitch">
        <div class="taxtext mt-3"><p>Pricing after taxes &nbsp; &nbsp;</p></div>
        <input class="form-check-input" type="checkbox" id="switchCheckReverse">
      </div>
    </div>
    <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1"><%for(let list of alllisting) {%> 
    <a class="listinglink" href="/listing/<%= list._id%>">
        <div class="card listing-card">
        <img src="<%= list.image.url%>" class="card-img-top" alt="Listing_image" style="height: 20rem;">
        <div class="card-body">
          <b><p class="card-text"><%=list.title%></b><br>
            <span>&#8377; <%=list.price%>/night</span>
        </p>
        </div>
    </div></a>
        <%}%> 
    </div>
</body>
